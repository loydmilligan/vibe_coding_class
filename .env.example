# Copy to .env (never commit .env) and fill in. Used by the help bot (helper/).

# OpenRouter key for the course help bot. Give the key a credit limit on openrouter.ai.
OPENROUTER_API_KEY=

# Model and limits (defaults shown)
HELP_BOT_MODEL=anthropic/claude-haiku-5.5
HELP_BOT_MAX_OUTPUT_TOKENS=700
HELP_BOT_DAILY_REQUESTS=150
HELP_BOT_DAILY_SPEND_USD=1.00

# Cloudflare Access: the bot refuses requests without a valid Access login.
# Team domain, e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The Application Audience (AUD) tag from the Access application's settings
CF_ACCESS_AUD=
# Optional: only these emails may use the bot (comma separated)
HELP_BOT_ALLOWED_EMAILS=

# Local testing only. 1 = no login check (anyone who can reach the port can spend the key).
HELP_BOT_ALLOW_NO_AUTH=0
